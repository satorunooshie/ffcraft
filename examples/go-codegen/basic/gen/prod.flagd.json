{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "checkout-mode": {
      "state": "ENABLED",
      "variants": {
        "control": "control",
        "treatment": "treatment"
      },
      "targeting": {
        "fractional": [
          {
            "var": "user.id"
          },
          [
            "control",
            1
          ],
          [
            "treatment",
            1
          ]
        ]
      }
    },
    "enable-new-home": {
      "state": "ENABLED",
      "variants": {
        "off": false,
        "on": true
      },
      "defaultVariant": "off",
      "targeting": {
        "if": [
          {
            "if": [
              {
                "missing": [
                  "device.platform"
                ]
              },
              false,
              {
                "===": [
                  {
                    "var": "device.platform"
                  },
                  "ios"
                ]
              }
            ]
          },
          "on",
          "off"
        ]
      }
    }
  }
}
