{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "experiment_rollout": {
      "state": "ENABLED",
      "variants": {
        "control": "control",
        "treatment": "treatment"
      },
      "defaultVariant": "control",
      "targeting": {
        "if": [
          {
            "if": [
              {
                "missing": [
                  "user.type"
                ]
              },
              false,
              {
                "===": [
                  {
                    "var": "user.type"
                  },
                  "internal"
                ]
              }
            ]
          },
          {
            "fractional": [
              {
                "var": "user.id"
              },
              [
                "control",
                67
              ],
              [
                "treatment",
                33
              ]
            ]
          },
          "control"
        ]
      }
    },
    "homepage_theme": {
      "state": "ENABLED",
      "variants": {
        "default": "default",
        "high_contrast": "high_contrast",
        "modern": "modern"
      },
      "defaultVariant": "default",
      "targeting": {
        "if": [
          {
            "if": [
              {
                "missing": [
                  "user.country"
                ]
              },
              false,
              {
                "===": [
                  {
                    "var": "user.country"
                  },
                  "JP"
                ]
              }
            ]
          },
          {
            "fractional": [
              {
                "var": "user.id"
              },
              [
                "default",
                5
              ],
              [
                "high_contrast",
                1
              ],
              [
                "modern",
                4
              ]
            ]
          },
          "default"
        ]
      }
    }
  }
}
